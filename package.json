{
  "name": "poe-svelte-ui-lib",
  "version": "2.17.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oleg-Perevyshin/ElementsUI.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/lib/constructor.ts",
    "./dist/constructor.js"
  ],
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "prepack": "npm run Generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-package && tsc -p tests/dist-types.tsconfig.json && node --test tests/*.test.mjs && publint",
    "Generate": "node scripts/GenerateDictionary.mjs && tsx scripts/UpdateIconsLib.ts && prettier --write --log-level warn src/lib/icons.ts",
    "Test": "npm run Generate && svelte-package && node --test tests/*.test.mjs",
    "Formatting": "prettier --write .",
    "CheckUpdate": "npx npm-check-updates -u && npm install"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./protocols": {
      "types": "./dist/protocols/index.d.ts",
      "default": "./dist/protocols/index.js"
    },
    "./dictionaries/*": "./dist/dictionaries/*",
    "./constructor": {
      "types": "./dist/constructor.d.ts",
      "svelte": "./dist/constructor.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "default": "./dist/locales/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "svelte",
    "ui",
    "components",
    "runes"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "dompurify": "^3.4.17",
    "maplibre-gl": "^6.17.0",
    "marked": "^18.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-compression": "^0.5.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
